# CorridorOS — environment template. All values below are placeholders.
# No real credentials, endpoints or keys belong in this repo (see CLAUDE.md §2).

# Postgres (not wired up yet — M1-M4 run entirely in-memory via the scenario runner)
DATABASE_URL=postgres://corridoros:corridoros@localhost:5432/corridoros

# Audit bundle signing key (Ed25519, generate your own for local use — never commit a real one)
AUDIT_SIGNING_KEY=REPLACE_WITH_LOCAL_ED25519_PRIVATE_KEY

# Ledger backend: "memory" (default, used by all tests and scenarios) or "sui" (localnet/testnet only)
LEDGER_BACKEND=memory

# Only meaningful when LEDGER_BACKEND=sui — must be a localnet/testnet URL, never mainnet
SUI_RPC_URL=http://127.0.0.1:9000
